    {
      "name": "RBAC Guards & Negative Tests",
      "item": [
        {
          "name": "[EC-1] Customer Calling Analytics Dashboard (403)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/analytics/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analytics",
                "dashboard"
              ]
            },
            "description": "Should return 403 Forbidden: Permission denied. Required: analytics:read."
          }
        },
        {
          "name": "[EC-2] Operator Calling Revenue Analytics (403)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operatorToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/analytics/revenue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analytics",
                "revenue"
              ]
            },
            "description": "Should return 403 Forbidden: Permission denied. Required: analytics:read."
          }
        },
        {
          "name": "[EC-3] Unauthenticated Analytics Request (401)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/analytics/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analytics",
                "dashboard"
              ]
            },
            "description": "Should return 401 Unauthorized: Access token required."
          }
        }
      ]
    }
