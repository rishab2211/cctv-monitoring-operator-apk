{
  "info": {
    "name": "Analytics & Reports Module Postman Collection",
    "description": "Complete, audited Analytics & Reports Module Postman Collection covering all 8 analytics endpoints including main dashboard summaries, alert distributions, camera uptime, operator rankings, revenue trends, subscription breakdowns, incident metrics, franchise comparisons, and RBAC guards per analytics_testing_guide.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Platform Performance & Operational Analytics",
      "item": [
        {
          "name": "/analytics/dashboard (Main Dashboard Summary)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/analytics/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analytics",
                "dashboard"
              ]
            },
            "description": "High-level KPI metrics summary across users, cameras, active incidents, and total revenue."
          }
        },
        {
