{
  "info": {
    "name": "Franchise Management Module Postman Collection",
    "description": "Complete, audited Franchise Management Module Postman Collection covering all 14 endpoints including franchise onboarding, territory configurations, customer mappings, CRM lead workflows, financial analytics (commission, royalty, sales), and status suspensions per franchise_testing_guide.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Franchise Lifecycle & Configuration",
      "item": [
        {
          "name": "/franchises (Create Franchise)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.franchise) {",
                  "    pm.environment.set(\"franchiseId\", jsonData.data.franchise._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Security Franchise — Mumbai West\",\n  \"franchiseCode\": \"ACME-MUM-01\",\n  \"ownerId\": \"{{franchiseOwnerId}}\",\n  \"contactEmail\": \"hello@acmesecurity.com\",\n  \"contactPhone\": \"9820012345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/franchises",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "franchises"
              ]
            },
            "description": "Register a new regional franchise entity (Admin only)."
          }
        },
        {
          "name": "[EC-1] ownerId does not have franchise role",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad Owner Franchise\",\n  \"franchiseCode\": \"BAD-01\",\n  \"ownerId\": \"{{operatorUserId}}\",\n  \"contactEmail\": \"badowner@acme.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/franchises",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "franchises"
              ]
            },
            "description": "Should return 400 Bad Request: User must have the franchise role."
          }
        },
        {
          "name": "[EC-2] Duplicate franchiseCode",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate Code Franchise\",\n  \"franchiseCode\": \"ACME-MUM-01\",\n  \"ownerId\": \"{{franchiseOwnerId}}\",\n  \"contactEmail\": \"dup@acme.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/franchises",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "franchises"
              ]
            },
            "description": "Should return 409 Conflict: Franchise code already exists."
          }
        },
        {
          "name": "/franchises (List All Franchises)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/franchises",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "franchises"
              ]
            },
            "description": "List platform franchises with aggregated camera and customer metrics (Admin only)."
          }
        },
        {
          "name": "/franchises/:id (View Franchise Details)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/franchises/{{franchiseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "franchises",
                "{{franchiseId}}"
              ]
            },
            "description": "Get franchise metadata, owner details, territory parameters, and operational status."
          }
        },
        {
          "name": "/franchises/:id (Suspend / Update Status)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"suspended\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/franchises/{{franchiseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "franchises",
                "{{franchiseId}}"
              ]
            },
            "description": "Suspend or modify franchise status (Admin only)."
          }
        }
      ]
    },
