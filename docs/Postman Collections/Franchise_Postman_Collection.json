          }
        },
        {
          "name": "/franchises/:id/customers (Get Franchise Customers)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/franchises/{{franchiseId}}/customers",
