            "description": "List all customer accounts and active cameras registered under this territory."
          }
        }
      ]
    },
    {
      "name": "CRM Sales Leads Management",
      "item": [
        {
          "name": "/franchises/:id/leads (Create Sales Lead)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
