{
  "info": {
    "name": "Operator Module Postman Collection",
    "description": "Complete, audited Operator Module Postman Collection covering Part A: Administrative & Management routes (/api/v1/operators) and Part B: Self-Service Operator Panel routes (/api/v1/operator) including shift tracking, bulk camera assignments, dashboard stats, live queues, talkback logs, and activity timelines per operator_testing_guide.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Part A: Management & Administrative Routes (/operators)",
      "item": [
        {
          "name": "/operators/clock-in (Clock In - Administrative)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operatorToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/operators/clock-in",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operators",
                "clock-in"
              ]
            },
            "description": "Operator clocks in to start active monitoring shift."
          }
        },
        {
          "name": "[EC-1] Clock In when already on shift",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operatorToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/operators/clock-in",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operators",
                "clock-in"
              ]
            },
            "description": "Should return 400 Bad Request: You already have an active shift."
          }
        },
        {
          "name": "/operators/shifts (List Historical Shifts)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/operators/shifts?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operators",
                "shifts"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "List historical shifts with scoping (Operators own shifts, Franchise territory, Admins all)."
          }
        },
        {
          "name": "/operators/:id/cameras (Bulk Assign Cameras)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cameraIds\": [\n    \"{{camera1Id}}\",\n    \"{{camera2Id}}\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/operators/{{operatorUserId}}/cameras",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operators",
                "{{operatorUserId}}",
                "cameras"
              ]
            },
            "description": "Bulk assign camera feeds to an operator (Super Admin, Admin, Franchise Admin)."
          }
        },
        {
          "name": "/operators/:id/performance (Get Performance Metrics)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/operators/{{operatorUserId}}/performance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operators",
                "{{operatorUserId}}",
                "performance"
              ]
            },
            "description": "Query operator shift count, incidents resolved, and response speed."
          }
        },
        {
          "name": "/operators/clock-out (Clock Out & Handover Notes)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operatorToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"handoverNotes\": \"Rear gate camera was occasionally losing signal. Guard alerted to keep visual monitoring.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/operators/clock-out",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operators",
                "clock-out"
              ]
            },
            "description": "Operator clocks out, logs handover notes, and calculates shift duration."
          }
        }
      ]
    },
    {
