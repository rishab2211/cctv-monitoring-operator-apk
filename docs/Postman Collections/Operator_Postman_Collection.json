              ]
            },
            "description": "Live queue of alerts currently being investigated or acknowledged by this operator."
          }
        },
        {
          "name": "/operator/calls (Recent Talkback Sessions)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operatorToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/operator/calls",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
