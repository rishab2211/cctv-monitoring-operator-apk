                "start"
              ]
            },
            "description": "Operator panel self-service shift start."
          }
        },
        {
          "name": "/operator/shift/status (Live Shift Status)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operatorToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/operator/shift/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
