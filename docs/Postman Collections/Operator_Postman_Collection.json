              ]
            },
            "description": "Chronological activity log of actions performed during the current work session."
          }
        },
        {
          "name": "/operator/reports (Operator Performance Report)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operatorToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/operator/reports",
