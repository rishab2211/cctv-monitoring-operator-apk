          }
        },
        {
          "name": "/operator/shift/end (End Shift - Panel)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operatorToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"handoverNotes\": \"All camera views clear. No pending incidents.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/operator/shift/end",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
