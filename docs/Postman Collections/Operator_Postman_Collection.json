              ]
            },
            "description": "Recent two-way audio talkback call history on assigned cameras."
          }
        },
        {
          "name": "/operator/shift/start (Start Shift - Panel)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operatorToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/operator/shift/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "operator",
