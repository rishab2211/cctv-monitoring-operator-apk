{
  "info": {
    "name": "SOS Emergency Response Module Postman Collection",
    "description": "Complete, audited SOS Emergency Response Module Postman Collection covering panic triggers (mobile app/hardware), active queue polling, operator acknowledgments, investigation notes, audit timelines, and resolutions per sos_testing_guide.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Emergency Triggers & Queue",
      "item": [
        {
          "name": "/sos (Trigger SOS Alert - With Location & Camera)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.sos) {",
                  "    pm.environment.set(\"sosId\", jsonData.data.sos._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cameraId\": \"{{cameraId}}\",\n  \"location\": \"Main Entrance Gate — 19.0760, 72.8777\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sos"
              ]
            },
            "description": "Trigger an SOS emergency panic alert with camera and location context."
          }
        },
        {
          "name": "/sos (Trigger SOS Alert - Empty Body)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/sos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sos"
              ]
            },
            "description": "Trigger panic alert without payload (auto-captures caller coordinates & identity)."
          }
        },
        {
          "name": "[EC-1] Invalid Camera ID Format",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cameraId\": \"123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sos"
              ]
            },
            "description": "Should return 400 Bad Request."
          }
        },
        {
          "name": "/sos (List SOS Alerts with Filters)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sos?page=1&limit=10&status=active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sos"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "active"
                }
              ]
            },
            "description": "List emergency alerts with multi-tenant scoping."
          }
        },
        {
          "name": "/sos/active (Get Active SOS Alerts)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sos/active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sos",
                "active"
              ]
            },
            "description": "Fetch live active SOS queue for emergency dispatchers."
          }
        },
        {
          "name": "/sos/:id (Get SOS Alert Details)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sos/{{sosId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sos",
                "{{sosId}}"
              ]
            },
            "description": "Get full SOS document including user contact and linked camera."
          }
        }
      ]
    },
    {
      "name": "Operator Triage & Resolution",
      "item": [
        {
          "name": "/sos/:id/acknowledge (Acknowledge SOS Alert)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/sos/{{sosId}}/acknowledge",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sos",
                "{{sosId}}",
                "acknowledge"
              ]
            },
            "description": "Operator takes ownership of emergency response (emits socket event)."
          }
        },
        {
          "name": "/sos/:id/notes (Add Investigation Note)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Operator visually confirmed emergency. Police and security dispatched to site.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sos/{{sosId}}/notes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sos",
                "{{sosId}}",
                "notes"
              ]
            },
            "description": "Append field notes and responder updates to SOS record."
          }
        },
        {
          "name": "/sos/:id/timeline (Get SOS Audit Timeline)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sos/{{sosId}}/timeline",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sos",
                "{{sosId}}",
                "timeline"
              ]
            },
            "description": "Retrieve chronological sequence of emergency events and operator actions."
          }
        },
        {
          "name": "/sos/:id/resolve (Resolve SOS Alert)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolutionNotes\": \"Emergency resolved. Premises secured and verified by on-site team.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sos/{{sosId}}/resolve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sos",
                "{{sosId}}",
                "resolve"
              ]
            },
            "description": "Formally resolve SOS alert and broadcast resolution status."
          }
        },
        {
          "name": "[EC-1] Resolve Missing Notes",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/sos/{{sosId}}/resolve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sos",
                "{{sosId}}",
                "resolve"
              ]
            },
            "description": "Should return 400 Bad Request: resolutionNotes required."
          }
        }
      ]
    }
  ]
}