          }
        },
        {
          "name": "/recordings/:id (Delete Recording Chunk)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/recordings/{{recordingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
