{
  "info": {
    "name": "Support Tickets Module Postman Collection",
    "description": "Complete, audited Support Tickets Module Postman Collection covering all 8 endpoints including ticket filing, multi-tenant list scoping, nested comment threads, agent assignments, status transitions, auto-reopening logic, and closures per ticket_testing_guide.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Ticket Lifecycle & Operations",
      "item": [
        {
          "name": "/tickets (Create Support Ticket)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.ticket) {",
                  "    pm.environment.set(\"ticketId\", jsonData.data.ticket._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Front Gate Camera live stream failing to connect\",\n  \"description\": \"The camera indicates offline status on the mobile app since 08:00 AM. Rebooted the local router but stream still fails.\",\n  \"category\": \"technical\",\n  \"priority\": \"high\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tickets"
              ]
            },
            "description": "Create a new support ticket (Customer, Operator, Technician, Franchise, Admin)."
          }
        },
        {
          "name": "/tickets (List Tickets - Scoped)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tickets?page=1&limit=10&status=open&priority=high",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tickets"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "open"
                },
                {
                  "key": "priority",
                  "value": "high"
                }
              ]
            },
            "description": "List tickets with scoping (Users see created; Franchise sees territory; Admins see all)."
          }
        },
        {
          "name": "/tickets/:id (Get Ticket Details & Thread)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tickets",
                "{{ticketId}}"
              ]
            },
            "description": "Get full ticket document with nested discussion thread and creator details."
          }
        },
        {
          "name": "/tickets/:id/assign (Assign Ticket to Agent)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignedTo\": \"{{assignedAgentId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/assign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tickets",
                "{{ticketId}}",
                "assign"
              ]
            },
            "description": "Assign ticket to support operator or technician (Super Admin, Admin, Franchise Admin)."
          }
        },
        {
          "name": "/tickets/:id (Update Priority & Category)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"critical\",\n  \"category\": \"technical\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tickets",
                "{{ticketId}}"
              ]
            },
            "description": "Update ticket priority or category (Admin, Franchise Admin)."
          }
        },
        {
          "name": "/tickets/:id/comments (Add Comment / Reply)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Technician dispatched to inspect on-site PoE switch and cable connections.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tickets",
                "{{ticketId}}",
                "comments"
              ]
            },
            "description": "Post reply message into the ticket thread. Auto-reopens closed tickets if posted by customer."
          }
        },
        {
          "name": "/tickets/:id/status (Update Ticket Status)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"resolved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tickets",
                "{{ticketId}}",
                "status"
              ]
            },
            "description": "Update status to in_progress or resolved (Admin, Franchise Admin, Assigned Agent)."
          }
        },
        {
          "name": "/tickets/:id/close (Close Support Ticket)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/close",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tickets",
                "{{ticketId}}",
                "close"
              ]
            },
            "description": "Formally close ticket (Admin, Franchise Admin, Ticket Creator)."
          }
        }
      ]
    }
  ]
}