    {
      "name": "register",
      "item": [
        {
          "name": "Happy Path (Register Super Admin / User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.tokens) {",
                  "    pm.environment.set(\"accessToken\", jsonData.data.tokens.accessToken);",
                  "    pm.environment.set(\"refreshToken\", jsonData.data.tokens.refreshToken);",
                  "    if (jsonData.data.tokens.sessionId) {",
                  "        pm.environment.set(\"sessionId\", jsonData.data.tokens.sessionId);",
                  "    }",
                  "    if (jsonData.data.user && jsonData.data.user._id) {",
                  "        pm.environment.set(\"userId\", jsonData.data.user._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Super Admin\",\n  \"email\": \"admin@cctvmonitor.com\",\n  \"phone\": \"9876543210\",\n  \"password\": \"Admin@1234\",\n  \"role\": \"super_admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Register a new user account. Returns user profile, JWT tokens, and sessionId."
          }
        },
