{
  "info": {
    "name": "Billing, Payments & Subscriptions Module Postman Collection",
    "description": "Complete, audited Billing & Subscriptions Module Postman Collection covering Part A: Subscription Plans (/plans), Part B: Subscriptions (/subscriptions), Part C: Razorpay Payments (/payments), and Part D: Invoices (/invoices) per billing_testing_guide.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Part A: Subscription Plans (/plans)",
      "item": [
        {
          "name": "/plans (Create Plan)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.plan) {",
                  "    pm.environment.set(\"planId\", jsonData.data.plan._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pro 4-Camera Monitoring\",\n  \"description\": \"24/7 AI-assisted monitoring and operator dispatch for up to 4 cameras.\",\n  \"price\": 2999,\n  \"durationMonths\": 1,\n  \"cameraLimit\": 4,\n  \"features\": [\n    \"24/7 Live Monitoring\",\n    \"AI Motion & Vehicle Detection\",\n    \"Emergency SOS Dispatch\",\n    \"7-Day Cloud Video Retention\"\n  ],\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans"
              ]
            },
            "description": "Create a subscription plan tier (Admin only)."
          }
        },
        {
          "name": "/plans (List Active Plans)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans"
              ]
            },
            "description": "List all active subscription plans (Public/Customer)."
          }
        },
        {
          "name": "/plans/:id (Update Plan)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 3499,\n  \"description\": \"Updated 24/7 AI-assisted monitoring for up to 4 cameras.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/plans/{{planId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans",
                "{{planId}}"
              ]
            },
            "description": "Update plan pricing or description (Admin only)."
          }
        },
        {
          "name": "/plans/:id (Delete Plan)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/plans/{{planId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans",
                "{{planId}}"
              ]
            },
            "description": "Delete plan (Admin only)."
          }
        }
      ]
    },
    {
      "name": "Part B: Subscriptions (/subscriptions)",
      "item": [
        {
          "name": "/subscriptions (Create Subscription)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data) {",
                  "    if (jsonData.data.subscription) pm.environment.set(\"subscriptionId\", jsonData.data.subscription._id);",
                  "    if (jsonData.data.invoice) pm.environment.set(\"invoiceId\", jsonData.data.invoice._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{planId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/subscriptions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subscriptions"
              ]
            },
            "description": "Subscribe customer to selected plan."
          }
        },
        {
          "name": "/subscriptions (List Subscriptions)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/subscriptions?page=1&limit=10&status=active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subscriptions"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "active"
                }
              ]
            },
            "description": "List subscriptions with pagination and status filter."
          }
        },
        {
          "name": "/subscriptions/:id (Get Subscription Details)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/subscriptions/{{subscriptionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subscriptions",
                "{{subscriptionId}}"
              ]
            },
            "description": "Get subscription document with plan specifications and active dates."
          }
        },
        {
          "name": "/subscriptions/:id/renew (Renew Subscription)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/subscriptions/{{subscriptionId}}/renew",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subscriptions",
                "{{subscriptionId}}",
                "renew"
              ]
            },
            "description": "Renew subscription for an additional cycle and generate invoice."
          }
        },
        {
          "name": "/subscriptions/:id/cancel (Cancel Subscription)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/subscriptions/{{subscriptionId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subscriptions",
                "{{subscriptionId}}",
                "cancel"
              ]
            },
            "description": "Cancel recurring subscription."
          }
        }
      ]
    },
    {
      "name": "Part C: Razorpay Payments (/payments)",
      "item": [
        {
          "name": "/payments/create-order (Create Razorpay Order)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data) {",
                  "    if (jsonData.data.orderId) pm.environment.set(\"orderId\", jsonData.data.orderId);",
                  "    if (jsonData.data.paymentId) pm.environment.set(\"paymentId\", jsonData.data.paymentId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subscriptionId\": \"{{subscriptionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/create-order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "create-order"
              ]
            },
            "description": "Initialize Razorpay checkout order."
          }
        },
        {
          "name": "/payments/verify (Verify Payment Signature Webhook)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razorpay_order_id\": \"{{orderId}}\",\n  \"razorpay_payment_id\": \"pay_mockTest987654\",\n  \"razorpay_signature\": \"mock_valid_hmac_sha256_signature\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "verify"
              ]
            },
            "description": "Verify Razorpay HMAC SHA256 payment signature and activate subscription."
          }
        },
        {
          "name": "/payments (List Payments)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/payments?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "List payment transaction records."
          }
        },
        {
          "name": "/payments/:id (Get Payment Details)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{paymentId}}"
              ]
            },
            "description": "Get payment transaction metadata and payment method details."
          }
        },
        {
          "name": "/payments/:id/refund (Refund Payment)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Customer cancellation within 7-day trial period.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentId}}/refund",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{paymentId}}",
                "refund"
              ]
            },
            "description": "Initiate payment refund (Admin only)."
          }
        }
      ]
    },
    {
      "name": "Part D: Billing Invoices (/invoices)",
      "item": [
        {
          "name": "/invoices (List Invoices)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/invoices?page=1&limit=10&status=paid",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "paid"
                }
              ]
            },
            "description": "List billing invoices with status filters."
          }
        },
        {
          "name": "/invoices/:id (Get Invoice Details)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/invoices/{{invoiceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices",
                "{{invoiceId}}"
              ]
            },
            "description": "Get itemized invoice details and payment due date."
          }
        },
        {
          "name": "/invoices/:id/download (Download Invoice PDF)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/invoices/{{invoiceId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices",
                "{{invoiceId}}",
                "download"
              ]
            },
            "description": "Download invoice PDF binary or signed download URL."
          }
        }
      ]
    }
  ]
}